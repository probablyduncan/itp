---
import { getTagColor } from '../lib/tags';
import fs from "fs";
import path from "path";
import sharp from "sharp"

interface Props {
    title: string;
    year: string;
    tags?: string[] | string;
    preview?: string;
    star?: true;
}

const { title, year, tags = [], preview, star = false } = Astro.props;

let previewSrc = "";
let previewRatio = 1;
if (preview) {
    previewSrc = path.join("images", preview);
    const previewAbsoluteSrc = path.join(process.cwd(), "public", previewSrc);
    if (fs.existsSync(previewAbsoluteSrc)) {
        const previewBuffer = fs.readFileSync(previewAbsoluteSrc);
        const metadata = await sharp(previewBuffer).metadata();
        previewRatio = metadata.width / metadata.height;
    }
    else {
        previewSrc = "";
    }
}
previewSrc = "";

const detailName = "project" + title;
---
<details name={detailName}>
    <summary>
        <div>
            <h2 class:list={{ star }}>{title}</h2>
            <span class="tags">
                {(Array.isArray(tags) ? tags : [tags]).map(tag => {
                    const color = getTagColor(tag);
                    return <span class="tag" style={`--color: ${color};`}>{tag.toUpperCase()}</span>
                })}
            </span>
            <span set:html={year}></span>
        </div>
        {!!previewSrc && <figure role="presentation">
            <img src={previewSrc} alt="" draggable="false" style={`--aspect-ratio: ${previewRatio}; --sqrt-ratio: ${Math.sqrt(previewRatio)}; rotate: ${Math.random() * 12 - 6}deg;`} />
        </figure>}
    </summary>
    <slot />
</details>
<style>

    details::before,
    details:last-of-type::after,
    details:open summary::after {
        content: "";
        width: 100%;
        display: block;
        background-color: black;
        border-radius: 0.2rem;
        height: 0.2rem;
    }

    details:open summary:not(:hover)::after {
        background-color: alpha(from black / 0.1);
    }

    summary {
        display: block;
        font-size: 1.618em;
        font-family: var(--vevey);
        cursor: pointer;

        div {
            display: grid;
            grid-template-columns: 1fr auto auto;
            justify-content: space-between;
            padding-block: 0.1em 0.2em;
            gap: 1em;
        }

        h2 {
            font-size: unset;
            margin: unset;
        }

        h2.star::after {
            content: " ✴︎";
            color: orange;
        }
    }

    summary:is(:hover, :focus-visible) {
        outline: none;
        div {
            color: white;
            background-color: black;
            border-radius: 0.125em;
            margin-inline: -0.125em;
            padding-inline: 0.125em;
        }
    }

    details:open {
        padding-block-end: 4rem;
    }

    .tags {
        display: flex;
        align-items: center;
        gap: 0.25em;
        margin-right: 0.25em;
    }

    .tag {
        font-size: 0.75em;
        color: white;
        background-color: var(--color, black);
        border-radius: 1em;
        padding: 0em .5em 0.1em;
        margin-top: 0.1em;
    }

    summary:not(:hover) figure, details:open figure {
        display: none;
    }

    details {
        position: relative;
    }

    details:open {
        z-index: 10;
        background-color: white;
    }

    figure {
        z-index: -1;
        margin: 0;

        display: flex;
        justify-content: center;
        align-items: center;

        pointer-events: none;
        user-select: none;

        position: absolute;
        inset: 0;
    }

    img {
        width: min(50vw * var(--sqrt-ratio, 1), calc(50vh * var(--sqrt-ratio, 1)));
    }
</style>