---
import { getTagColor } from "../lib/tags";
import fs from "fs";
import path from "path";
import sharp from "sharp";

interface Props {
    title: string;
    year: string;
    tags?: string[] | string;
    preview?: string;
    star?: true;
    previewNoBorder?: true;
}

const {
    title,
    year,
    tags = [],
    preview,
    star = false,
    previewNoBorder = false,
} = Astro.props;

let previewSrc = "";
let previewRatio = 1;
if (preview) {
    previewSrc = path.join("images", preview);
    const previewAbsoluteSrc = path.join(process.cwd(), "public", previewSrc);
    if (fs.existsSync(previewAbsoluteSrc)) {
        const previewBuffer = fs.readFileSync(previewAbsoluteSrc);
        const metadata = await sharp(previewBuffer).metadata();
        previewRatio = metadata.width / metadata.height;
    } else {
        previewSrc = "";
    }
}

const previewRotation =
    (Math.random() * 2 + 2) * Math.sign(Math.random() - 0.5);

const detailName = "project" + title;
---

<details name={detailName}>
    <summary>
        <div class="summary-wrapper">
            <h2 class:list={{ star }}>{title}</h2>
            <div class="tags">
                {(Array.isArray(tags) ? tags : [tags]).map((tag) => {
                    const color = getTagColor(tag);
                    return (
                        <span class="tag" style={`--color: ${color};`}>
                            {tag.toUpperCase()}
                        </span>
                    );
                })}
            </div>
            <div class="year" set:html={year} />
        </div>
        {!!previewSrc && (
            <figure>
                <img
                    src={previewSrc}
                    alt=""
                    class:list={{ bordered: !previewNoBorder }}
                    draggable="false"
                    style={`--aspect-ratio: ${previewRatio}; --sqrt-ratio: ${Math.sqrt(previewRatio)}; rotate: ${previewRotation}deg;`}
                />
            </figure>
        )}
    </summary>
    <slot />
</details>
<style>
    details::before,
    details:last-of-type::after,
    details:open summary::after {
        content: "";
        width: 100%;
        display: block;
        background-color: black;
        border-radius: 0.2rem;
        height: 0.2rem;
    }

    details:open summary:not(:hover)::after {
        background-color: alpha(from black / 0.1);
    }

    summary {
        display: block;
        font-size: 1.618em;
        font-family: var(--vevey);
        cursor: pointer;

        .summary-wrapper {
            display: grid;
            grid-template-columns: 1fr auto auto;
            justify-content: space-between;
            align-items: center;
            padding-block: 0.1em 0.2em;
            column-gap: 1em;

            @media (max-width: 699px) {
                display: flex;
                flex-wrap: wrap;
            }
        }

        h2 {
            font-size: unset;
            margin: unset;
        }

        h2.star::after {
            content: " ✴︎";
            color: orange;
        }
    }

    summary:is(:hover, :focus-visible) {
        outline-color: transparent;
        outline: none;
        .summary-wrapper {
            color: white;
            background-color: black;
            border-radius: 0.125em;
            margin-inline: -0.125em;
            padding-inline: 0.125em;
        }
    }

    details:open {
        padding-block-end: 4rem;
    }

    .tags {
        display: flex;
        align-items: center;
        flex-wrap: wrap;
    }

    .tag {
        font-size: 0.75em;
        color: white;
        background-color: var(--color, black);
        border-radius: 1em;
        padding: 0em 0.5em 0.1em;
        margin-top: 0.1em;
        margin-right: 0.25em;
    }

    details {
        position: relative;
        background-color: white;
    }

    details:open {
        z-index: 20;
    }

    figure {
        opacity: 0;
        visibility: hidden;
        z-index: 10;
        margin: 0;

        display: flex;
        justify-content: center;
        align-items: center;

        pointer-events: none;
        user-select: none;
        -webkit-user-select: none;

        position: absolute;
        inset: 0;
    }

    @media (hover: hover) {
        details:not([open]) summary:hover figure {
            opacity: 1;
            visibility: visible;
        }
    }

    img {
        width: calc(27% * var(--sqrt-ratio, 1));
        image-rendering: optimizeQuality;
        border-radius: 0.2rem;
    }

    img.bordered {
        border: 0.2rem solid black;
        box-shadow: 0 0 2rem alpha(from black / 0.1);
    }

    ::-ms-details-marker,
    ::-moz-details-marker,
    ::-webkit-details-marker,
    ::details-marker,
    ::-ms-marker,
    ::-moz-marker,
    ::-webkit-marker,
    ::marker,
    summary::-ms-details-marker,
    summary::-moz-details-marker,
    summary::-webkit-details-marker,
    summary::details-marker,
    summary::-ms-marker,
    summary::-moz-marker,
    summary::-webkit-marker,
    summary::marker,
    details summary::-ms-details-marker,
    details summary::-moz-details-marker,
    details summary::-webkit-details-marker,
    details summary::details-marker,
    details summary::-ms-marker,
    details summary::-moz-marker,
    details summary::-webkit-marker,
    details summary::marker {
        display: none;
    }
</style>
